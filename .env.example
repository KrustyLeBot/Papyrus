# Papyrus: copy to .env next to docker-compose.yml and adjust. Never commit the real file.

# ---- docker-compose ----
# Local access: http://<NAS address>:8096 ; the Cloudflare tunnel goes to http://papyrus:8080
WEB_PORT=8096
# The owner of both folders below (`id <user>` over SSH). On a Synology the first user is usually 1026:100.
PUID=1026
PGID=100
# The folders Papyrus reads (mounted read-only): the PDF and DOCX files found anywhere below are indexed.
PAPYRUS_SOURCE_HOST=/volume1/Jerome
# Papyrus' own state: database, thumbnails, unlocked copies of protected PDFs, models, daily snapshots.
PAPYRUS_DATA_HOST=/volume1/docker/papyrus/data

# ---- scan ----
# Seconds between two scans of the source folder (a new or moved file shows up within that time)
SCAN_INTERVAL_SEC=60
# File types read, comma separated (pdf, docx; jpg, png, txt, md are understood too, off by default)
SCAN_EXTENSIONS=pdf,docx
# Files and folders skipped, by name (case-insensitive globs)
SCAN_EXCLUDE=@eaDir,#recycle,#snapshot,@Recycle,.*,~$*,Thumbs.db,desktop.ini,*.tmp
# Files bigger than this are not read (MB)
SCAN_MAX_FILE_MB=300
# A file modified less than this many seconds ago is left for the next scan (still being copied)
SCAN_SETTLE_SEC=5

# ---- machine profile ----
# The defaults are for a small NAS without AVX (Synology DS918+, 4-8 GB). For a PC with AVX2 and RAM to spare
# (an i5 8th gen, 16 GB) use:
#   EMBED_THREADS=4   OCR_THREADS=4   EMBED_IDLE_UNLOAD_MIN=0 (never unload: the first search is instant)   MEM_LIMIT=4g
# Container memory ceiling
MEM_LIMIT=1g
# Embeddings model: small (default, ~120 MB, 384 dims) or base (~280 MB, 768 dims, slower, see README). Changing it
# recomputes every embedding by itself (document count x ~0.1-0.5 s), and its similarity threshold has its own default.
EMBED_MODEL=small

# ---- analysis ----
# OCR (Tesseract): threads per document. Documents are processed one at a time.
OCR_THREADS=2
# Pages OCRed per document (0 = all)
OCR_MAX_PAGES=0
# Embeddings (multilingual-e5-small): threads, and minutes of inactivity before the model leaves memory
EMBED_THREADS=2
EMBED_IDLE_UNLOAD_MIN=15
# A local mirror of the model (same layout as Xenova/multilingual-e5-small), empty = Hugging Face, first start only
MODEL_URL=

# ---- search (adjustable live in Administration; these are the starting values) ----
# empty = the measured default of the model (small 0.86, base 0.84)
SEARCH_SEMANTIC_MIN=
SEARCH_PREFIX=true
SEARCH_FUZZY=true

# ---- database ----
# auto: SQLite uses WAL on a local disk and the DELETE journal when the data folder is on an NFS/SMB share.
# wal | delete force it. Whatever the mode: one Papyrus instance per data folder.
PAPYRUS_JOURNAL=auto

# ---- security ----
# Login session length in days
SESSION_DAYS=30
# true only behind Cloudflare Access (anyone reaching the port is then logged in)
AUTH_DISABLED=false
# Behind the Cloudflare tunnel: trust CF-Connecting-IP (login throttle) and X-Forwarded-Proto (Secure cookie).
TRUST_PROXY=true
# Only these peers may set those headers: the tunnel's docker network (`docker network inspect tunnel`), e.g. 172.18.0.0/16.
TRUSTED_PROXIES=
# auto: Secure cookie over https (the tunnel), plain over http on the LAN. true | false to force.
COOKIE_SECURE=auto
# Saved PDF passwords are encrypted with a key derived from your login password (nothing to set here).
# Daily snapshots of the database kept in data/backups (0 = none)
BACKUP_KEEP=7
